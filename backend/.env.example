# Copy to backend/.env and fill in. NEVER commit backend/.env. Do not use production credentials locally.
APP_ENV=development
LOG_LEVEL=INFO

# Postgres connection string from Supabase (Project Settings -> Database). Use a DEV project.
DATABASE_URL=

# Supabase Auth (used from Phase 5 for JWT verification)
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated explicit origins; wildcard is rejected at startup
CORS_ORIGINS=http://localhost:3000

# Optional; AI explanations are disabled when empty (Phase 9)
AI_PROVIDER_API_KEY=
